{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentide.dev/schemas/vocabulary.schema.json",
  "title": "OpenTide Vocabulary TOML",
  "type": "object",
  "required": ["name", "field", "version"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "field": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Vocabulary contract version in major.minor form."
    },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "key": { "type": "string", "enum": ["name", "id"] },
    "model": { "type": "boolean" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "icon": { "type": "string" }
            },
            "anyOf": [
              { "required": ["id"] },
              { "required": ["name"] }
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
